rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in can read/create posts.
    // Only the original poster can edit/delete their own post
    // (accepting a claim happens through the /claims subcollection instead).
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      // Claims live under each post.
      // Anyone signed in can read and submit a claim.
      // Only the post's owner can change a claim's status (accept/reject).
      match /claims/{claimId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.claimantUid == request.auth.uid;
        allow update: if request.auth != null
                      && get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid == request.auth.uid;
      }
    }

    // Users can only write their own profile doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
